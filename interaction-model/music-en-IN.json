{
  "_comment": "Source of truth for the music skill's en-IN interaction model. Not served by the app — copy/paste this into that skill's JSON Editor, under the en-IN locale tab. Identical to music-en-US.json; included from the start so a device/account registered in India isn't blocked by a region/locale mismatch (see music-en-US.json's comment and the search skill's README for the full rationale). Keep both files in sync.",
  "interactionModel": {
    "languageModel": {
      "invocationName": "my music",
      "intents": [
        { "name": "AMAZON.CancelIntent", "samples": [] },
        { "name": "AMAZON.HelpIntent", "samples": [] },
        { "name": "AMAZON.StopIntent", "samples": [] },
        { "name": "AMAZON.NavigateHomeIntent", "samples": [] },
        { "name": "AMAZON.FallbackIntent", "samples": [] },
        { "name": "AMAZON.PauseIntent", "samples": [] },
        { "name": "AMAZON.ResumeIntent", "samples": [] },
        { "name": "AMAZON.NextIntent", "samples": [] },
        { "name": "AMAZON.PreviousIntent", "samples": [] },
        {
          "name": "PlayIntent",
          "slots": [
            { "name": "song", "type": "AMAZON.SearchQuery" }
          ],
          "samples": [
            "play {song}",
            "to play {song}",
            "play the song {song}",
            "put on {song}",
            "listen to {song}",
            "i want to hear {song}",
            "start playing {song}"
          ]
        }
      ]
    }
  }
}
